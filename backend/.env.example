# ============================================
# SIH26182 - Crypto VASP Attribution Engine
# Environment Configuration
# ============================================
# Copy this file to .env and fill in your keys
# DO NOT commit .env to version control!
# ============================================

# --- Ethereum APIs ---
# Alchemy: https://dashboard.alchemy.com/
ALCHEMY_API_KEY=your_alchemy_api_key_here
ALCHEMY_ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your_alchemy_api_key_here

# Infura (optional backup): https://app.infura.io/register
INFURA_API_KEY=your_infura_api_key_here
INFURA_ETH_RPC_URL=https://mainnet.infura.io/v3/your_infura_api_key_here

# Etherscan: https://etherscan.io/register
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# --- Tron APIs ---
# TronGrid: https://www.trongrid.io/
TRONGRID_API_KEY=your_trongrid_api_key_here

# TronScan (no key needed for basic access)
TRONSCAN_API_URL=https://apilist.tronscanapi.com

# --- Graph Database ---
# Neo4j (local dev): https://neo4j.com/download/
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# --- ClickHouse (optional for Phase 2) ---
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
TRACE_RESULT_TTL_SECONDS=86400

# --- LLM (Phase 2 - Attribution Tagging) ---
# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional absolute path to a provenance-backed VASP label registry.
# If omitted, backend/data/vasp_labels.json is used.
VASP_LABELS_PATH=

# --- Application Settings ---
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-this-to-a-random-secret-key

# --- Rate Limiting ---
ETHERSCAN_RATE_LIMIT=5
MAX_TRANSFERS_PER_ADDRESS=1000
ETHERSCAN_PAGE_SIZE=1000
TRONGRID_RATE_LIMIT=10
TRONSCAN_PAGE_SIZE=100
